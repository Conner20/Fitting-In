{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitting-in-metrics-sync",
  "main": "metrics-sync-worker.js",
  "compatibility_date": "2026-10-06",
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
